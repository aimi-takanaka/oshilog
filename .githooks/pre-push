#!/bin/sh
cd "$(dirname "$0")/.." || exit 1

deploy=0
while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/main) deploy=1 ;;
  esac
done

if [ "$deploy" -eq 1 ]; then
  echo "main への push に合わせて本番へデプロイします..."
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./scripts/deploy.ps1" || exit 1
fi

exit 0
